<body>

    <div id="navbar">
        <input type="text" id="urlInput" placeholder="Enter URL (e.g., wikipedia.org)">
        <button onclick="navigate()">Go</button>
    </div>

    <canvas id="browser-viewport" width="1280" height="720"></canvas>

    <script>
        const canvas = document.getElementById('browser-viewport');
        const ctx = canvas.getContext('2d');
        const urlInput = document.getElementById('urlInput');
        
        // Establish WebSocket connection to the Node.js server
        const ws = new WebSocket(`ws://${window.location.host}`);
        ws.binaryType = 'blob';

        // Render binary images received from server onto the canvas
        ws.onmessage = (event) => {
            if (event.data instanceof Blob) {
                const img = new Image();
                img.onload = () => {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    ctx.drawImage(img, 0, 0);
                };
                img.src = URL.createObjectURL(event.data);
            }
        };

        // Capture local mouse clicks and send coordinates to the remote browser
        canvas.addEventListener('click', (e) => {
            const rect = canvas.getBoundingClientRect();
            // Scale click coordinates relative to the 1280x720 canvas resolution
            const x = (e.clientX - rect.left) * (canvas.width / rect.width);
            const y = (e.clientY - rect.top) * (canvas.height / rect.height);
            
            ws.send(JSON.stringify({ type: 'click', x: Math.round(x), y: Math.round(y) }));
        });

        // Capture local keystrokes and pass them to the remote browser
        window.addEventListener('keydown', (e) => {
            // Ignore system keys or input box focus
            if (document.activeElement === urlInput || e.key.length > 1) return;
            ws.send(JSON.stringify({ type: 'type', key: e.key }));
        });

        // Trigger navigation function
        function navigate() {
            const url = urlInput.value.trim();
            if (url) {
                ws.send(JSON.stringify({ type: 'navigate', url: url }));
            }
        }
    </script>
</body>
</html>

const express = require('express');
const http = require('http');
const WebSocket = require('ws');
const puppeteer = require('puppeteer');
const path = require('path');
const crypto = require('crypto');

const app = express();
const server = http.createServer(app);
const wss = new WebSocket.Server({ server });

app.use(express.static(path.join(__dirname, 'public')));

// Active sessions registry
const activeSessions = new Map();

wss.on('connection', async (ws) => {

    // Generate a unique identifier for the user session
    const sessionId = crypto.randomUUID();
    console.log(`User connected. Created session: ${sessionId}`);

    try {
        // Launch a dedicated browser and page instance for this user
        const browser = await puppeteer.launch({
            headless: true,
            args: ['--no-sandbox', '--disable-setuid-sandbox']
        });
        const page = await browser.newPage();
        await page.setViewport({ width: 1280, height: 720 });
        await page.goto('https://google.com');

        // Frame rendering loops per session
        const streamInterval = setInterval(async () => {
            if (ws.readyState === WebSocket.OPEN) {
                try {
                    const screenshot = await page.screenshot({ type: 'jpeg', quality: 55 });
                    ws.send(screenshot);
                } catch (err) {
                    // Fail silently if page closes during capture
                }
            }
        }, 110); // ~9 Frames Per Second to manage CPU across threads

        // Save session references
        activeSessions.set(sessionId, { browser, page, streamInterval });

    } catch (err) {
        console.error(`Initialization failed for session ${sessionId}:`, err);
        ws.close();
        return;
    }

    // Process isolated client interactions
    ws.on('message', async (message) => {
        const session = activeSessions.get(sessionId);
        if (!session) return;

        try {
            const data = JSON.parse(message);
            if (data.type === 'click') {
                await session.page.mouse.click(data.x, data.y);
            } 
            else if (data.type === 'type') {
                await session.page.keyboard.sendCharacter(data.key);
            } 
            else if (data.type === 'navigate') {
                let url = data.url;
                if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
                await session.page.goto(url);
            }
        } catch (err) {
            console.error(`Interaction error in session ${sessionId}:`, err);
        }
    });

    // Cleanup resources explicitly upon user exit
    ws.on('close', async () => {
        const session = activeSessions.get(sessionId);
        if (session) {
            clearInterval(session.streamInterval);
            await session.browser.close();
            activeSessions.delete(sessionId);
            console.log(`Cleaned up resources for completed session: ${sessionId}`);
        }
    });
});

