<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Virtual Browser Client</title>
    <style>
        body { font-family: Arial, sans-serif; background: #222; color: #fff; text-align: center; margin: 0; padding: 10px; }
        #navbar { margin-bottom: 10px; display: flex; justify-content: center; gap: 10px; }
        #urlInput { width: 50%; padding: 8px; border-radius: 4px; border: none; }
        button { padding: 8px 16px; border-radius: 4px; border: none; cursor: pointer; background: #007bff; color: white; }
        #browser-viewport { border: 2px solid #555; background: #000; cursor: crosshair; max-width: 100%; display: block; margin: 0 auto; }
    </style>
