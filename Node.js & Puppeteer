const express = require('express');
const http = require('http');
const WebSocket = require('ws');
const puppeteer = require('puppeteer');
const path = require('path');
const crypto = require('crypto');
const fs = require('fs');
const chokidar = require('chokidar');

const app = express();
const server = http.createServer(app);
const wss = new WebSocket.Server({ server });

app.use(express.static(path.join(__dirname, 'public')));

// Ensure target directories exist
const DOWNLOADS_BASE = path.resolve(__dirname, 'downloads');
const PROFILES_BASE = path.resolve(__dirname, 'profiles');
if (!fs.existsSync(DOWNLOADS_BASE)) fs.mkdirSync(DOWNLOADS_BASE);
if (!fs.existsSync(PROFILES_BASE)) fs.mkdirSync(PROFILES_BASE);

// HTTP Endpoint for local client file retrieval
app.get('/download/:sessionId/:filename', (req, { params }, next) => {
    const filePath = path.join(DOWNLOADS_BASE, params.sessionId, params.filename);
    // Secure path traversal protection
    if (!filePath.startsWith(DOWNLOADS_BASE)) return res.status(403).send('Access Denied');
    
    fs.existsSync(filePath) ? res.download(filePath) : res.status(404).send('File not found');
});

const activeSessions = new Map();

wss.on('connection', async (ws) => {

    // Session token used for persistent profile naming and isolated downloads
    const sessionId = crypto.randomUUID();
    const userProfileDir = path.join(PROFILES_BASE, `user-${sessionId}`);
    const userDownloadDir = path.join(DOWNLOADS_BASE, sessionId);
    
    if (!fs.existsSync(userDownloadDir)) fs.mkdirSync(userDownloadDir);

    console.log(`Session ${sessionId} initialized with persistent profile storage.`);

    try {
        // COOKIE PERSISTENCE: Launching with launchPersistentContext retains cookies/history on server reboots
        const browserContext = await puppeteer.launchPersistentContext(userProfileDir, {
            headless: true,
            args: ['--no-sandbox', '--disable-setuid-sandbox', '--window-size=1280,720']
        });
        
        const page = await browserContext.newPage();
        await page.setViewport({ width: 1280, height: 720 });

        // DOWNLOAD INTERCEPTION: Attach directly to Chrome DevTools Protocol
        const cdp = await page.target().createCDPSession();
        await cdp.send('Page.setDownloadBehavior', {
            behavior: 'allow',
            downloadPath: userDownloadDir
        });

        // Watch download folder for completed file downloads
        const watcher = chokidar.watch(userDownloadDir, { ignoreInitial: true, depth: 0 });
        watcher.on('add', (filePath) => {
            const filename = path.basename(filePath);
            // Ignore temporary Chrome download extensions
            if (filename.endsWith('.crdownload') || filename.endsWith('.tmp')) return;

            // Signal frontend via WebSocket that a file is ready for pickup
            if (ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ type: 'download-ready', filename, sessionId }));
            }
        });

        await page.goto('https://google.com');

        const streamInterval = setInterval(async () => {
            if (ws.readyState === WebSocket.OPEN) {
                try {
                    const screenshot = await page.screenshot({ type: 'jpeg', quality: 55 });
                    ws.send(screenshot);
                } catch (e) {}
            }
        }, 110);

        activeSessions.set(sessionId, { browserContext, page, streamInterval, watcher });

    } catch (err) {
        console.error(`Session failure: ${sessionId}`, err);
        ws.close();
        return;
    }

    ws.on('message', async (message) => {
        const session = activeSessions.get(sessionId);
        if (!session) return;
        try {
            const data = JSON.parse(message);
            if (data.type === 'click') await session.page.mouse.click(data.x, data.y);
            else if (data.type === 'type') await session.page.keyboard.sendCharacter(data.key);
            else if (data.type === 'navigate') {
                let url = data.url;
                if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
                await session.page.goto(url);
            }
        } catch (e) {}
    });

    ws.on('close', async () => {
        const session = activeSessions.get(sessionId);
        if (session) {
            clearInterval(session.streamInterval);
            session.watcher.close();
            await session.browserContext.close();
            activeSessions.delete(sessionId);
            console.log(`Resources closed for session: ${sessionId}`);
        }
    });
});

